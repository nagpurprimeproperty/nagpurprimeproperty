# Ignore dependencies
**/node_modules
**/.pnpm-store

# Ignore Next.js & build outputs
**/.next
**/out
**/dist
**/build

# Ignore environment variables & secrets (inject at runtime, never bake into image)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.crt
*.pfx
*.p12
*.keystore
id_rsa*
serviceAccountKey.json
firebase-*.json
google-services.json
GoogleService-Info.plist
**/*.script.js

# Ignore version control & logs
.git
.gitignore
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# Ignore OS / IDE files
.DS_Store
*.swp
.vscode
.idea

# TypeScript build info
**/tsconfig.tsbuildinfo
